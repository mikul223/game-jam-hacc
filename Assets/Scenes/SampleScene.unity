  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 75c5fb0542128dd4fa20fb73ab3a79ba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  npcName: 
  normalSprite: {fileID: -2461384720135325843, guid: 96616106ffb739746a9b33b9ce12c9a7, type: 3}
  angrySprite: {fileID: 9107198430715910371, guid: fc3795b6712ffa845999df13d1e1c46f, type: 3}
  sadSprite: {fileID: 1032480927257246808, guid: 808cc9604cc16d0409ab5cd7e9a807bc, type: 3}
  happySprite: {fileID: -285691891547158316, guid: 4c64c09c3a1038446b65e009de742c3b, type: 3}
  scaredSprite: {fileID: -9084554921681531370, guid: 13fbed5e7e33a1c4eab7ab21d0392df2, type: 3}
  normalPortrait: {fileID: -2461384720135325843, guid: 96616106ffb739746a9b33b9ce12c9a7, type: 3}
  angryPortrait: {fileID: 9107198430715910371, guid: fc3795b6712ffa845999df13d1e1c46f, type: 3}
  sadPortrait: {fileID: 1032480927257246808, guid: 808cc9604cc16d0409ab5cd7e9a807bc, type: 3}
  happyPortrait: {fileID: -285691891547158316, guid: 4c64c09c3a1038446b65e009de742c3b, type: 3}
  scaredPortrait: {fileID: -9084554921681531370, guid: 13fbed5e7e33a1c4eab7ab21d0392df2, type: 3}
  normalDialogs:
  - "\u041E\u0442\u0434\u044B\u0445\u0430\u044E. \u0412\u0441\u0451 \u043A\u0430\u043A
    \u0432\u0441\u0435\u0433\u0434\u0430, \u0432\u0441\u0451 \u0445\u043E\u0440\u043E\u0448\u043E."
  - "\u0421\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u2014
    \u0432\u043E\u0442 \u0447\u0442\u043E \u0432\u0430\u0436\u043D\u043E, \u043F\u043E\u0434\u0440\u0443\u0433\u0430"
  angryDialogs:
  - "\u042F \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0434\u0435\u0441\u044C
    \u0436\u0438\u0432\u0443, \u0430 \u0442\u044B \u0432\u0441\u0451 \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u043B
    \u0437\u0430 \u0434\u0435\u043D\u044C!"
  - "\u041F\u043E\u0437\u043E\u0440.."
  sadDialogs:
  - "\u0412\u0441\u0451 \u0432\u0430\u043C \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u044B
    \u043F\u043E\u0434\u0430\u0432\u0430\u0439.."
  - "\u0410 \u0432\u0435\u0434\u044C \u0440\u0430\u043D\u044C\u0448\u0435 \u0442\u0430\u043A
    \u0445\u043E\u0440\u043E\u0448\u043E \u0431\u044B\u043B\u043E. \u0421\u043F\u043E\u043A\u043E\u0439\u043D\u043E.."
  happyDialogs:
  - "\u0425\u0430-\u0445\u0430! \u041A\u0430\u043A\u043E\u0439 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439
    \u0434\u0435\u043D\u044C!"
  - "\u0425\u0430-\u0445\u0430! \u041A\u0430\u043A\u043E\u0439 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439
    \u0434\u0435\u043D\u044C!"
  scaredDialogs:
  - "\u0411\u0435\u0440\u0435\u0433\u0438\u0441\u044C. \u0427\u0442\u043E-\u0442\u043E
    \u043D\u0430\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F..."
  - "\u0421\u043F\u0440\u044F\u0447\u0443\u0441\u044C-\u043A\u0430 \u044F \u0434\u043E\u043C\u0430..."
  promptText: {fileID: 1735328486}
  dialogPanel: {fileID: 451245553}
  npcPortrait: {fileID: 1376498650}
  dialogText: {fileID: 2090164525}
