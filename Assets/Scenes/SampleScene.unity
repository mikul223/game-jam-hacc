  m_Script: {fileID: 11500000, guid: 75c5fb0542128dd4fa20fb73ab3a79ba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  npcName: 
  normalSprite: {fileID: 5641194326797936795, guid: dc0d087a92956824cab4b30b814a2c6c, type: 3}
  angrySprite: {fileID: 8212250814737068943, guid: 8e5f828246a9fbf4bb67a7a425af39b5, type: 3}
  sadSprite: {fileID: 5856682564919291344, guid: 0bf08bcbcdb2a9d4996a55831742918e, type: 3}
  happySprite: {fileID: 1486581418119907875, guid: 0b91e9d3eac0de64a8c57b39a83fd764, type: 3}
  scaredSprite: {fileID: -3955067329591337687, guid: eafae839751caf749a3f027162b2d39c, type: 3}
  normalPortrait: {fileID: 5641194326797936795, guid: dc0d087a92956824cab4b30b814a2c6c, type: 3}
  angryPortrait: {fileID: 8212250814737068943, guid: 8e5f828246a9fbf4bb67a7a425af39b5, type: 3}
  sadPortrait: {fileID: 5856682564919291344, guid: 0bf08bcbcdb2a9d4996a55831742918e, type: 3}
  happyPortrait: {fileID: 1486581418119907875, guid: 0b91e9d3eac0de64a8c57b39a83fd764, type: 3}
  scaredPortrait: {fileID: -3955067329591337687, guid: eafae839751caf749a3f027162b2d39c, type: 3}
  normalDialogs:
  - "\u0414\u043E\u0431\u0440\u043E\u0435 \u0443\u0442\u0440\u043E! \u0425\u043E\u0440\u043E\u0448\u0438\u0439
    \u0434\u0435\u043D\u0451\u043A \u0441\u0435\u0433\u043E\u0434\u043D\u044F"
  - "\u041A\u0430\u043A \u0441\u043F\u0430\u043B\u043E\u0441\u044C? \u041D\u0430\u0434\u0435\u044E\u0441\u044C,
    \u0432\u044B\u0441\u043F\u0430\u043B\u0438\u0441\u044C."
  angryDialogs:
  - "\u0422\u044B \u0432\u043E\u043E\u0431\u0449\u0435 \u0434\u0443\u043C\u0430\u0435\u0448\u044C
    \u0433\u043E\u043B\u043E\u0432\u043E\u0439?! \u0412\u0441\u0451 \u0438\u0437-\u0437\u0430
    \u0442\u0435\u0431\u044F!"
  - "\u0414\u0430\u0436\u0435 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043D\u0430
    \u0442\u0435\u0431\u044F \u043D\u0435 \u0445\u043E\u0447\u0443."
  sadDialogs:
  - "\u0417\u0430\u0447\u0435\u043C \u0432\u0441\u0451 \u044D\u0442\u043E... \u0420\u0430\u043D\u044C\u0448\u0435
    \u0431\u044B\u043B\u043E \u0442\u0430\u043A \u0445\u043E\u0440\u043E\u0448\u043E..."
  - "\u041C\u043D\u0435 \u0433\u0440\u0443\u0441\u0442\u043D\u043E. \u041E\u0447\u0435\u043D\u044C
    \u0433\u0440\u0443\u0441\u0442\u043D\u043E."
  happyDialogs:
  - "\u041E\u0439, \u043A\u0430\u043A \u044F \u0440\u0430\u0434\u0430 \u0442\u0435\u0431\u044F
    \u0432\u0438\u0434\u0435\u0442\u044C! \u041F\u0440\u044F\u043C\u043E \u0421\u041B\u0418\u0428\u041A\u041E\u041C
    \u0440\u0430\u0434\u0430!"
  - "\u0417\u0430\u0445\u043E\u0434\u0438 \u043D\u0430 \u0447\u0430\u0439!)"
  scaredDialogs:
  - "\u041D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438... \u042F \u0431\u043E\u044E\u0441\u044C."
  - "\u0422\u044B \u0441\u043B\u044B\u0448\u0430\u043B \u044D\u0442\u043E\u0442 \u0437\u0432\u0443\u043A?
    \u041C\u043D\u0435 \u0441\u0442\u0440\u0430\u0448\u043D\u043E."
  promptText: {fileID: 1735328486}
  dialogPanel: {fileID: 451245553}
  npcPortrait: {fileID: 1376498650}
  dialogText: {fileID: 2090164525}
