  normalPortrait: {fileID: -3738487170075062984, guid: eb8ca33c06537714a9e163d06aa21b8d, type: 3}
  angryPortrait: {fileID: -1763487222864237783, guid: 6403df9fa56972c4cb9dcc53a3d0eb34, type: 3}
  sadPortrait: {fileID: -8642857959393074519, guid: 6d40367e0648ea147bc0c49fa6a1cafb, type: 3}
  happyPortrait: {fileID: -3026397036932506956, guid: 8910afb6f2737ea4db10fa65af5e0f52, type: 3}
  scaredPortrait: {fileID: 9145521974051391609, guid: 236074d637574f54093f52640c6eb0ba, type: 3}
  normalDialogs:
  - "\u0425\u043E\u0440\u043E\u0448\u0430\u044F \u043F\u043E\u0433\u043E\u0434\u0430
    \u0434\u043B\u044F \u043F\u0440\u043E\u0433\u0443\u043B\u043A\u0438 \u0441 \u043F\u0441\u043E\u043C."
  angryDialogs:
  - "\u0422\u044B \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u043B\u0430 \u0432\u0441\u0451!"
  - "\u0423\u0445\u043E\u0434\u0438. \u041D\u0430\u043C \u0441 \u0442\u043E\u0431\u043E\u0439
    \u043D\u0435 \u043F\u043E \u043F\u0443\u0442\u0438."
  sadDialogs:
  - "\u0414\u0430\u0436\u0435 \u0441\u043E\u0431\u0430\u043A\u0430 \u0433\u0440\u0443\u0441\u0442\u0438\u0442...
    \u0427\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442, \u0447\u0442\u043E \u0447\u0442\u043E-\u0442\u043E
    \u043D\u0435 \u0442\u0430\u043A."
  - "\u041C\u043E\u0436\u0435\u0442, \u0437\u0430\u0432\u0442\u0440\u0430 \u0431\u0443\u0434\u0435\u0442
    \u043B\u0443\u0447\u0448\u0435? \u0425\u043E\u0442\u044F \u0432\u0440\u044F\u0434
    \u043B\u0438."
  happyDialogs:
  - "\u0414\u0420\u0423\u0413!!! \u0418\u0434\u0438 \u0441\u044E\u0434\u0430, \u043E\u0431\u043D\u0438\u043C\u0443!
    \u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0445\u043E\u0440\u043E\u0448\u043E,
    \u0447\u0442\u043E\u0431\u044B \u0431\u044B\u0442\u044C \u043F\u0440\u0430\u0432\u0434\u043E\u0439!"
  scaredDialogs:
  - "\u042F \u0434\u043E\u043C\u043E\u0439. \u0421\u043E\u0431\u0430\u043A\u0430
    \u0442\u043E\u0436\u0435 \u043D\u0430\u043F\u0443\u0433\u0430\u043D\u0430. \u0417\u0430\u043A\u0440\u044B\u0432\u0430\u0439
    \u0434\u0432\u0435\u0440\u0438."
  - "\u0422\u044B \u0432\u0438\u0434\u0435\u043B\u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445?
    \u041E\u043D\u0438 \u0432\u0441\u0435 \u043D\u0430\u043F\u0443\u0433\u0430\u043D\u043D\u044B."
  promptText: {fileID: 1735328486}
  dialogPanel: {fileID: 451245553}
  npcPortrait: {fileID: 1376498650}
  dialogText: {fileID: 2090164525}
