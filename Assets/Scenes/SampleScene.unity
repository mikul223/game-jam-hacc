  m_Script: {fileID: 11500000, guid: 75c5fb0542128dd4fa20fb73ab3a79ba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  npcName: 
  normalSprite: {fileID: 2891244019715949673, guid: 4329a7df70ac9a84a8489afedacc8da2, type: 3}
  angrySprite: {fileID: -8358770957938671477, guid: ba7e6673cd0eeed48b18c373180ccb05, type: 3}
  sadSprite: {fileID: 32560116412326046, guid: 2eab634d4064290419d8d4b777ff9469, type: 3}
  happySprite: {fileID: -2339939813278094674, guid: e8503cd75d064b04aa8cd9beae3872d3, type: 3}
  scaredSprite: {fileID: -4942087743484774903, guid: 883d420b96d381546af86e8370aaf8d1, type: 3}
  normalPortrait: {fileID: 2891244019715949673, guid: 4329a7df70ac9a84a8489afedacc8da2, type: 3}
  angryPortrait: {fileID: -8358770957938671477, guid: ba7e6673cd0eeed48b18c373180ccb05, type: 3}
  sadPortrait: {fileID: 32560116412326046, guid: 2eab634d4064290419d8d4b777ff9469, type: 3}
  happyPortrait: {fileID: -2339939813278094674, guid: e8503cd75d064b04aa8cd9beae3872d3, type: 3}
  scaredPortrait: {fileID: -4942087743484774903, guid: 883d420b96d381546af86e8370aaf8d1, type: 3}
  normalDialogs:
  - "\u0422\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0448\u044C \u0432\u0430\u0436\u043D\u0443\u044E
    \u0440\u0430\u0431\u043E\u0442\u0443, \u044D\u0442\u043E \u043A\u0440\u0443\u0442\u043E!"
  angryDialogs:
  - "\u0422\u044B \u043F\u043B\u043E\u0445\u0430\u044F! \u042F \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443
    \u0432\u0441\u0435\u043C, \u0447\u0442\u043E \u0442\u044B \u043D\u0430\u0434\u0435\u043B\u0430\u043B\u0430!"
  - "\u041D\u0435 \u0445\u043E\u0447\u0443 \u0441 \u0442\u043E\u0431\u043E\u0439
    \u0438\u0433\u0440\u0430\u0442\u044C. \u0423\u0445\u043E\u0434\u0438."
  sadDialogs:
  - "\u041F\u043E\u0447\u0435\u043C\u0443 \u0432\u0441\u0451 \u0441\u0442\u0430\u043B\u043E
    \u0441\u0435\u0440\u044B\u043C? \u0412\u0435\u0440\u043D\u0438 \u043A\u0430\u043A
    \u0431\u044B\u043B\u043E..."
  - "\u042F \u0441\u043A\u0443\u0447\u0430\u044E, \u043A\u043E\u0433\u0434\u0430
    \u0432\u0441\u0451 \u0431\u044B\u043B\u043E \u0445\u043E\u0440\u043E\u0448\u043E."
  happyDialogs:
  - "\u0423\u0420\u0410!!! \u0422\u044B \u043F\u0440\u0438\u0448\u043B\u0430! \u0414\u0430\u0432\u0430\u0439
    \u0438\u0433\u0440\u0430\u0442\u044C!"
  - "\u042D\u0442\u043E \u0441\u0430\u043C\u044B\u0439 \u043B\u0443\u0447\u0448\u0438\u0439
    \u0434\u0435\u043D\u044C! \u0421\u0410\u041C\u042B\u0419-\u0421\u0410\u041C\u042B\u0419!"
  scaredDialogs:
  - "\u041C\u043D\u0435 \u0441\u0442\u0440\u0430\u0448\u043D\u043E... \t"
  - "\u0422\u044B \u0442\u043E\u0436\u0435 \u044D\u0442\u043E \u0432\u0438\u0434\u0435\u043B\u0430?"
  promptText: {fileID: 1735328486}
  dialogPanel: {fileID: 451245553}
  npcPortrait: {fileID: 1376498650}
  dialogText: {fileID: 2090164525}
