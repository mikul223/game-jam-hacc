--- !u!114 &1292325529
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1292325527}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 75c5fb0542128dd4fa20fb73ab3a79ba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  npcName: 
  normalSprite: {fileID: 8648965193734291049, guid: 096143e1a0f7b5147bf3048c2423b02a, type: 3}
  angrySprite: {fileID: -5026666244863179163, guid: 1d66926ead3c9814d813c044d098baee, type: 3}
  sadSprite: {fileID: 3790797026785440916, guid: 14839f6eedc09e44d89af2bc3f15d87d, type: 3}
  happySprite: {fileID: 66024821176191796, guid: be576e50971353848aae9ccc8b222c36, type: 3}
  scaredSprite: {fileID: -4516826772384205552, guid: 531d1091d1115664e9c744540df16e50, type: 3}
  normalPortrait: {fileID: 8648965193734291049, guid: 096143e1a0f7b5147bf3048c2423b02a, type: 3}
  angryPortrait: {fileID: -5026666244863179163, guid: 1d66926ead3c9814d813c044d098baee, type: 3}
  sadPortrait: {fileID: 3790797026785440916, guid: 14839f6eedc09e44d89af2bc3f15d87d, type: 3}
  happyPortrait: {fileID: 66024821176191796, guid: be576e50971353848aae9ccc8b222c36, type: 3}
  scaredPortrait: {fileID: -4516826772384205552, guid: 531d1091d1115664e9c744540df16e50, type: 3}
  normalDialogs:
  - "\u0426\u0432\u0435\u0442\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B.
    \u0412\u0441\u0451 \u043A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u043E."
  - "\u041B\u044E\u0431\u043B\u044E, \u043A\u043E\u0433\u0434\u0430 \u0432\u0441\u0451
    \u0438\u0434\u0451\u0442 \u0441\u0432\u043E\u0438\u043C \u0447\u0435\u0440\u0435\u0434\u043E\u043C."
  angryDialogs:
  - "\u0422\u044B \u0432\u0441\u0451 \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u043B\u0430!"
  - "\u042D\u0442\u043E \u0436\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u0440\u043D\u043E!
    \u041A\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0442\u0430\u043A\u043E\u0439
    \u043D\u0435\u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439?"
  sadDialogs:
  - "\u0426\u0432\u0435\u0442\u044B \u043F\u043E\u043D\u0438\u043A\u043B\u0438...
    \u041E\u043D\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E\u0442, \u0447\u0442\u043E
    \u0432\u0441\u0451 \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E."
  - "\u042F \u0441\u043A\u0443\u0447\u0430\u044E \u043F\u043E \u043E\u0431\u044B\u0447\u043D\u044B\u043C
    \u0434\u043D\u044F\u043C."
  happyDialogs:
  - "\u0426\u0432\u0435\u0442\u044B \u0422\u0410\u041A\u0418\u0415 \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0435!
    \u041F\u0440\u044F\u043C\u043E \u043A\u0430\u043A \u0442\u044B!!! \u0414\u0430\u0432\u0430\u0439
    \u0434\u0440\u0443\u0436\u0438\u0442\u044C?"
  scaredDialogs:
  - "\u0426\u0432\u0435\u0442\u044B \u0437\u0430\u0432\u044F\u043B\u0438... \u042D\u0442\u043E
    \u043F\u043B\u043E\u0445\u043E\u0439 \u0437\u043D\u0430\u043A. \u041E\u0447\u0435\u043D\u044C
    \u043F\u043B\u043E\u0445\u043E\u0439"
  - "\u042F \u0437\u0430\u043A\u0440\u043E\u044E \u043E\u0440\u0430\u043D\u0436\u0435\u0440\u0435\u044E.
    \u0418 \u0442\u044B \u0441\u043F\u0440\u044F\u0447\u044C\u0441\u044F"
  promptText: {fileID: 1735328486}
  dialogPanel: {fileID: 451245553}
  npcPortrait: {fileID: 1376498650}
  dialogText: {fileID: 2090164525}
